{
  "name": "epub-parser-mcp",
  "version": "1.0.0",
  "description": "MCP server for parsing EPUB files",
  "type": "module",
  "bin": {
    "epub-parser-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "start": "node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.5.0",
    "adm-zip": "^0.5.10",
    "cheerio": "^1.0.0-rc.12",
    "xml2js": "^0.6.2"
  },
  "keywords": [
    "mcp",
    "epub",
    "parser",
    "ebook"
  ],
  "author": "kala",
  "license": "GPL",
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.9.1",
    "@types/xml2js": "^0.4.14",
    "typescript": "^5.9.3"
  }
}
