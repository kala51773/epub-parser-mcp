  },
  "keywords": [
    "mcp",
    "epub",
    "parser",
    "ebook",
    "model-context-protocol",
    "ai",
    "claude",
    "text-extraction",
    "ebook-parser"
  ],
  "author": "kala",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/kala51773/epub-parser-mcp.git"
  },
  "homepage": "https://github.com/kala51773/epub-parser-mcp#readme",
  "bugs": {
    "url": "https://github.com/kala51773/epub-parser-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "build/",
    "README.md"
  ],
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.9.1",
    "@types/xml2js": "^0.4.14",
    "typescript": "^5.9.3"
  }
